    "normalize:log-created-at": "cross-env DOTENV_CONFIG_PATH=./.env.local tsx scripts/normalize-log-created-at.ts",
    "clean:orphan-pulses": "cross-env DOTENV_CONFIG_PATH=./.env.local tsx scripts/clean-dev-orphan-pulses.ts",
    "purge:e2e-users": "cross-env DOTENV_CONFIG_PATH=./.env.local tsx scripts/purge-e2e-users.ts",
    "clone:neo4j": "tsx scripts/clone-neo4j.ts",
    "clone:dev-to-demo": "tsx scripts/clone-neo4j.ts local demo",
    "clone:dev-to-prod": "tsx scripts/clone-neo4j.ts local production",
    "clone:demo-to-dev": "tsx scripts/clone-neo4j.ts demo local",
    "reset:dev-password": "tsx scripts/reset-dev-password.ts",
    "setup:env": "bash scripts/setup-environment.sh",
    "workers": "cross-env DOTENV_CONFIG_PATH=./.env.local tsx src/lib/jobs/workers.ts"
